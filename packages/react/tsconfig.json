{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "importHelpers": false,
    "emitDecoratorMetadata": false,
    "experimentalDecorators": false,
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.mts"]
}
