{
  "name": "css",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/css",
  "projectType": "library",
  "tags": ["scope:shared", "type:ui"],
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"]
    }
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/css"],
      "inputs": [
        "production",
        "{workspaceRoot}/tools/css-package.mjs",
        "{workspaceRoot}/packages/css/README.md"
      ],
      "options": {
        "command": "node tools/css-package.mjs build"
      }
    }
  }
}
