{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@lamsa-ui/angular": ["./packages/angular/src/index.ts"],
      "@lamsa-ui/icons": ["./packages/icons/src/index.ts"],
      "@lamsa-ui/react": ["./packages/react/src/index.ts"],
      "@lamsa-ui/vue": ["./packages/vue/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
